NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Unlocks POST /api/dev/seed-state (see that route for details) —
# a test-only backdoor for setting up board states directly instead of
# playing dice out for real. Only takes effect when NODE_ENV !== "production"
# to begin with; leave this unset (or set it only for Preview/Development in
# your host's environment-variable scoping, never Production) to keep the
# route unreachable everywhere it could matter.
DEV_HARNESS_SECRET=

# Optional. Gates GET /api/bugs, PATCH /api/bugs/[id], and the /bugs review
# page (pass it as ?secret=... on any of them). Unlike DEV_HARNESS_SECRET,
# this is meant to stay set in Production — bug reports only matter once
# real players are filing them — the secret itself is what keeps the review
# surface private. Leave unset to make /bugs and the GET/PATCH endpoints
# unreachable (they 404) everywhere.
ADMIN_SECRET=
